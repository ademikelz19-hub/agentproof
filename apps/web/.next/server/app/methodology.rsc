4:["$","a",null,{"href":"https://github.com/agentproof/agentproof/blob/main/docs/RELIABILITY_METHODOLOGY.md","children":"RELIABILITY_METHODOLOGY.md"}]
5:["$","section",null,{"style":{"marginTop":"2rem"},"children":[["$","h2",null,{"style":{"fontSize":"1.1rem"},"children":"Evidence coverage"}],["$","p",null,{"style":{"color":"#444","maxWidth":680,"lineHeight":1.6},"children":"Every reliability figure carries an explicit sufficiency tier — INSUFFICIENT, LIMITED, MODERATE, or STRONG. This is a statement about how much measurement coverage backs the number, never a judgment about the agent. \"STRONG\" evidence does not mean \"safe agent\" — it means AgentProof has enough observations, spread widely and recently enough across the window, to show a meaningful figure."}]]}]
6:["$","section",null,{"style":{"marginTop":"2rem"},"children":[["$","h2",null,{"style":{"fontSize":"1.1rem"},"children":"Reputation integrity"}],["$","p",null,{"style":{"color":"#444","maxWidth":680,"lineHeight":1.6},"children":["AgentProof analyses the shape of available feedback — reviewer concentration, diversity, burst patterns — using deterministic, reproducible formulas. It never runs ML-based Sybil classification and never labels a reviewer or wallet as fake, malicious, or fraudulent. Full formulas and false-positive risks are documented in"," ",["$","a",null,{"href":"https://github.com/agentproof/agentproof/blob/main/docs/REPUTATION_INTEGRITY.md","children":"REPUTATION_INTEGRITY.md"}],"."]}]]}]
7:["$","section",null,{"style":{"marginTop":"2rem"},"children":[["$","h2",null,{"style":{"fontSize":"1.1rem"},"children":"Limitations"}],["$","ul",null,{"style":{"color":"#444","maxWidth":680,"lineHeight":1.8,"paddingLeft":"1.2rem"},"children":[["$","li",null,{"children":"Protocol validation beyond plain HTTP (A2A, MCP) is not implemented yet."}],["$","li",null,{"children":"Sufficiency thresholds are documented, deterministic constants — not a statistical model."}],["$","li",null,{"children":"No feedback-ingestion pipeline exists yet, so reputation evidence is currently empty for every agent."}],["$","li",null,{"children":"Reciprocal-feedback-pattern detection requires cross-agent data AgentProof does not yet have."}]]}]]}]
8:["$","section",null,{"style":{"marginTop":"2rem"},"children":[["$","h2",null,{"style":{"fontSize":"1.1rem"},"children":"Security & probe policy"}],["$","p",null,{"style":{"color":"#444","maxWidth":680,"lineHeight":1.6},"children":["Every probe goes through an SSRF-hardened transport (DNS-pinned connections, re-validated redirects, strict timeouts and size caps) and respects conservative concurrency/backoff limits so AgentProof never becomes a load source against the agents it monitors. Full detail in"," ",["$","a",null,{"href":"https://github.com/agentproof/agentproof/blob/main/docs/SECURITY_MODEL.md","children":"SECURITY_MODEL.md"}]," ","and"," ",["$","a",null,{"href":"https://github.com/agentproof/agentproof/blob/main/docs/PROBE_POLICY.md","children":"PROBE_POLICY.md"}],"."]}]]}]
