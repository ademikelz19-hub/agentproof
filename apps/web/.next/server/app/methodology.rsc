cripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]]}],{"children":[["$","$1","c",{"children":[["$","div",null,{"style":{"maxWidth":880,"margin":"0 auto","padding":"0 1.5rem"},"children":[["$","nav",null,{"style":{"display":"flex","gap":"1.5rem","alignItems":"center","padding":"1.5rem 0","borderBottom":"1px solid #e5e5e5","marginBottom":"2rem","fontSize":"0.95rem"},"children":[["$","a",null,{"href":"/","style":{"fontWeight":700,"textDecoration":"none","color":"inherit","marginRight":"auto"},"children":"AgentProof"}],["$","a",null,{"href":"/agents","children":"Explore Agents"}],["$","a",null,{"href":"/methodology","children":"Methodology"}],["$","a",null,{"href":"/developers","children":"Developers"}]]}],["$","main",null,{"style":{"paddingBottom":"4rem"},"children":[["$","h1",null,{"style":{"fontSize":"1.6rem"},"children":"Methodology"}],["$","p",null,{"style":{"color":"#555","maxWidth":680,"lineHeight":1.6},"children":"This page explains what AgentProof measures, how, and — just as importantly — what it does not claim. Every number shown anywhere in the product traces back to one of the mechanisms below."}],["$","section",null,{"style":{"marginTop":"2rem"},"children":[["$","h2",null,{"style":{"fontSize":"1.1rem"},"children":"Identity vs. reliability"}],["$","p",null,{"style":{"color":"#444","maxWidth":680,"lineHeight":1.6},"children":"ERC-8004 registration proves an agent identity was registered onchain. It says nothing about whether the advertised service currently works. AgentProof measures the second thing independently — it never treats onchain registration itself as evidence of reliability."}]]}],["$","section",null,{"style":{"marginTop":"2rem"},"children":[["$","h2",null,{"style":{"fontSize":"1.1rem"},"children":"Reachability vs. correctness"}],["$","p",null,{"style":{"color":"#444","maxWidth":680,"lineHeight":1.6},"children":["A successful probe means AgentProof could connect and get a well-formed response. It does not mean the response was correct, or that the agent's advertised functionality actually works as described. \"HTTP 200\" and \"this agent works correctly\" are different claims, and AgentProof never conflates them — see ",["$","code",null,{"children":"PROTOCOL_RESPONSE_VALIDITY"}]," in the reliability methodology for the (currently HTTP-only) exception."]}]]}],["$","section",null,{"style":{"marginTop":"2rem"},"children":[["$","h2",null,{"style":{"fontSize":"1.1rem"},"children":"Reliability measurement"}],["$","p",null,{"style":{"color":"#444","maxWidth":680,"lineHeight":1.6},"children":["Five probe types (metadata resolution, service reachability, HTTP status, response latency, protocol response validity) run against advertised services on a schedule. Every result is stored as an append-only observation with full provenance. See the full methodology, including the exact availability/latency formulas and evidence-sufficiency rules, in"," ","$L4","."]}]]}],"$L5","$L6","$L7","$L8"]}]]}],null,"$L9"]}],{},null,false,null]},null,false,"$a"]},null,false,null],"$Lb",false]],"m":"$undefined","G":["$c",[]],"S":true,"h":null,"r":"$undefined","s":"$undefined","a":"$undefined","l":"$undefined","p":"$undefined","d":"$undefined","b":"0ThWTzOMj1vRniVvDeC3s"}
